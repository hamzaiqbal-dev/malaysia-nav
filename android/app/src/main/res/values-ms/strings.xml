<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- SECTION: Malaysia Nav navigation HUD -->
    <!-- Accessibility label of the big turn arrow in the navigation HUD. -->
    <string name="my_nav_next_turn">Belokan seterusnya</string>
    <!-- Label above the small arrow showing the turn after the next one, e.g. "Then ↱". Keep very short. -->
    <string name="my_nav_then">Kemudian</string>
    <!-- Button that ends navigation. Keep very short. -->
    <string name="my_nav_end">Tamat</string>
    <!-- Accessibility label of the voice guidance on/off button in the navigation HUD. -->
    <string name="my_nav_voice">Panduan suara</string>
    <!-- Remaining travel time in minutes, e.g. "14 min". Keep very short. -->
    <string name="my_nav_eta_minutes">%d min</string>
    <!-- Remaining travel time in whole hours, e.g. "2 h". Keep very short. -->
    <string name="my_nav_eta_hours">%d j</string>
    <!-- Remaining travel time in hours and minutes, e.g. "1 h 5 min". Keep very short. -->
    <string name="my_nav_eta_hours_minutes">%1$d j %2$d min</string>
    <!-- Line under the remaining time: %1$s is the remaining distance (e.g. 6.4 km), %2$s the arrival clock time. -->
    <string name="my_nav_eta_subtitle">%1$s · tiba %2$s</string>
    <!-- Label of the toll total in the navigation ETA sheet. Keep very short. -->
    <string name="my_nav_toll">Tol</string>
    <!-- Toll total in Malaysian ringgit; %s is the amount, e.g. "RM 2.10". A trailing + means some booths on the route have no price yet. -->
    <string name="my_nav_toll_amount">RM %s</string>
    <!-- Quick search chip on the map (petrol stations). Keep to one short word. -->
    <string name="my_chip_fuel">Minyak</string>
    <!-- Quick search chip on the map (mosques and prayer rooms). Keep to one short word. -->
    <string name="my_chip_surau">Surau</string>
    <!-- Quick search chip on the map (restaurants). Keep to one short word. -->
    <string name="my_chip_mamak">Mamak</string>
    <!-- Quick search chip on the map (parking). Keep to one short word. -->
    <string name="my_chip_parking">Parkir</string>
    <!-- Quick search chip on the map (EV chargers). Keep to one short word. -->
    <string name="my_chip_ev">EV</string>
    <!-- Quick search chip on the map (clinics). Keep to one short word. -->
    <string name="my_chip_clinic">Klinik</string>
    <!-- Quick search chip on the map (highway rest areas). Keep to one short word. -->
    <string name="my_chip_rest_area">R&amp;R</string>
    <!-- Quick search chip on the map (toilets). Keep to one short word. -->
    <string name="my_chip_toilet">Tandas</string>
    <!-- Quick search chip on the map (ATMs). Keep to one short word. -->
    <string name="my_chip_atm">ATM</string>
</resources>
