<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Malaysia Nav navigation HUD (NavHudView). Set to false to fall back to the stock Organic Maps HUD. -->
  <bool name="my_nav_hud_enabled">true</bool>
  <!-- Quick search chips (Malaysian places) above the map buttons. -->
  <bool name="my_explore_chips_enabled">true</bool>

  <dimen name="my_hud_margin">12dp</dimen>
  <!-- Portrait phones fill the width; in landscape and on tablets the HUD stays a start-aligned column. -->
  <dimen name="my_hud_max_width">400dp</dimen>
  <!-- Corner radii: sheet 24, banner 20, pill = half height, control 12. -->
  <dimen name="my_hud_corner">20dp</dimen>
  <dimen name="my_hud_sheet_corner">24dp</dimen>
  <dimen name="my_control_corner">12dp</dimen>
  <dimen name="my_turn_icon_corner">16dp</dimen>
  <dimen name="my_pill_corner">28dp</dimen>
  <dimen name="my_lanes_corner">26dp</dimen>
  <dimen name="my_chip_corner">18dp</dimen>
  <!-- 8dp grid: outer margin 12 (half step, as in the concept), inner padding 16/8. -->
  <dimen name="my_hud_padding">16dp</dimen>
  <dimen name="my_hud_gap">8dp</dimen>
  <dimen name="my_hud_elevation">8dp</dimen>
  <dimen name="my_turn_icon_size">64dp</dimen>
  <dimen name="my_turn_icon_padding">4dp</dimen>
  <dimen name="my_then_icon_size">22dp</dimen>
  <dimen name="my_lanes_height">52dp</dimen>
  <dimen name="my_speed_limit_size">56dp</dimen>
  <!-- Minimum touch target (WCAG 2.5.5 / Material): 48dp. -->
  <dimen name="my_touch_target">48dp</dimen>
  <!-- Chips: 36dp pill inset in a 48dp touch target (my_bg_chip). -->
  <dimen name="my_chip_height">36dp</dimen>
  <dimen name="my_chip_inset">6dp</dimen>

  <dimen name="my_text_turn_distance">30sp</dimen>
  <dimen name="my_text_turn_street">15sp</dimen>
  <dimen name="my_text_then">12sp</dimen>
  <dimen name="my_text_eta">28sp</dimen>
  <dimen name="my_text_eta_min">20sp</dimen>
  <dimen name="my_text_toll_label">11sp</dimen>
  <dimen name="my_text_toll_amount">14sp</dimen>
  <dimen name="my_text_eta_subtitle">13sp</dimen>
  <dimen name="my_text_speed">22sp</dimen>
  <dimen name="my_text_speed_units">10sp</dimen>
  <dimen name="my_text_button">14sp</dimen>
  <dimen name="my_text_chip">13sp</dimen>
</resources>
