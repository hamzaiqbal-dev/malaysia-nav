<?xml version="1.0" encoding="utf-8"?>
<!-- 36dp pill inset top and bottom so the chip view itself is a 48dp touch target. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
  android:insetTop="@dimen/my_chip_inset"
  android:insetBottom="@dimen/my_chip_inset">
  <ripple android:color="@color/my_line">
    <item>
      <shape android:shape="rectangle">
        <solid android:color="@color/my_panel" />
        <stroke
          android:width="1dp"
          android:color="@color/my_line" />
        <corners android:radius="@dimen/my_chip_corner" />
      </shape>
    </item>
  </ripple>
</inset>
