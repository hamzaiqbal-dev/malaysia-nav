/* 1.BASEMAP */

@background: #E8EAED;

/* 2.BOUNDARY */

@border_country: #63635C;
@border_region: #73726B;
@indigenous_lands: #734D26;

/* 3.NATURAL */
/* 3.1 Main natural */

@glacier: #FFFFFF;
@water: #A3CDF5;
@water_bad: #B4CFE6;
@water_intermittent: #CFE3F7;
@river: #5BA3E6;
@wetland: #7F9FB8;
@beach: #F6EBC2;
@barerock: #DADCDF;
@scree: #D2D5D9;
@desert: #EFE8CD;

/*3.2 Vegetation*/

@green0: #D9EBCF;
@green1: #D2E7C7;
