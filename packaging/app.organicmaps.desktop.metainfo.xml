<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>app.organicmaps.desktop</id>

  <name>Sampai</name>
  <developer id="app.organicmaps">
    <name>Sampai</name>
  </developer>
  <summary>Offline navigation made in Malaysia</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Apache-2.0</project_license>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>

  <content_rating type="oars-1.1" />

  <description>
    <p>
      Sampai is an offline navigation app made in Malaysia, with Bahasa Melayu first, toll prices in RM
      and Malaysian places such as surau, R&amp;R and mamak built in.
    </p>
    <p>
      Maps work without an internet connection, with no ads, no tracking and no account.
      Map data comes from OpenStreetMap contributors.
    </p>
  </description>

  <url type="homepage">https://github.com/hamzaiqbal-dev/malaysia-nav</url>
  <url type="bugtracker">https://github.com/hamzaiqbal-dev/malaysia-nav/issues</url>
  <url type="vcs-browser">https://github.com/hamzaiqbal-dev/malaysia-nav</url>

  <launchable type="desktop-id">app.organicmaps.desktop.desktop</launchable>

  <releases>
    <release version="2026.11.04" date="2026-11-04" type="development">
      <description>
        <p>First Sampai build.</p>
      </description>
    </release>
  </releases>
</component>
